# ------------------------------------------------------------------
# Kitchen's Worth — environment variables
# Copy to `.env.local` for local dev. Vercel project env vars mirror
# these names. Owners are documented in docs/ENVIRONMENT.md.
# ------------------------------------------------------------------

# Supabase (project: kitchensworth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never expose to browser
DATABASE_URL=                        # psql connection for seed script

# Monnify (Nigeria payments)
NEXT_PUBLIC_MONNIFY_PUBLIC_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WEBHOOK_AUTH_HASH=           # for verifying Bepin-Signature HMAC
MONNIFY_BASE_URL=https://api.monnify.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=2347030606021

# Admin bootstrap (email of the first admin — must exist in auth.users)
ADMIN_EMAIL=
